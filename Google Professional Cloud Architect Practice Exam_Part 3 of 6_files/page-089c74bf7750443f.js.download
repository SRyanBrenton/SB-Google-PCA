:!1,rating:5,quote:"The questions really helped pass the exam, congrats for the great work.",date:"2026-08-30",url:"https://www.trustpilot.com/reviews/6a948a35c0d1dd5052050d1c"},{id:"tp-8",platform:"trustpilot",name:"Ramzi Fridhi",isUsername:!1,rating:5,quote:"Can't recommend enough.",date:"2026-08-23",url:"https://www.trustpilot.com/reviews/6a8b5ab323df7fe939394135"},{id:"tp-1",platform:"trustpilot",name:"T.M. Fahim Amin",isUsername:!1,rating:5,quote:"I used ExamAcademy to prepare for the GCP PCA exam. It has a really nice question set, I got almost 70% question similar to the question set available here. I really like that ExamAcademy provide a nice interface even for free account without tricking the user. I hope, this stays free like this so that people can benefit from it. I also like their voluntary support method for folks who can support it.",date:"2026-07-15",url:"https://www.trustpilot.com/reviews/6a57b06a123ce7c412b10029"},{id:"tp-2",platform:"trustpilot",name:"Thijs",isUsername:!1,rating:5,quote:"Great site to practice the cpc-sen exam. Will keep using it for future exams.",date:"2026-07-07",url:"https://www.trustpilot.com/reviews/6a4d6fd369fa2f7ec87bbf46"},{id:"tp-3",platform:"trustpilot",name:"Dulcie Agyekum",isUsername:!1,rating:5,quote:"Simple questions and easy to understand. I believe the concepts were covered but need to put in more current questions.",date:"2026-07-06",url:"https://www.trustpilot.com/reviews/6a4b5e375e9a2d38eb0b97be"},{id:"tp-4",platform:"trustpilot",name:"David",isUsername:!1,rating:5,quote:"Very useful set of questions to prepare the Test.",date:"2026-06-03",url:"https://www.trustpilot.com/reviews/6a1fb6aa851267ee5ef7f40a"},{id:"tp-5",platform:"trustpilot",name:"Mattias Seemann",isUsername:!1,rating:5,quote:"I used Examcademy to prepare for the PL-600 (Power Platform Solution Architect) and passed on my first try. The content covered the exam topics really well — I didn't run into any surprises on the actual test, which says a lot. The platform itself is straightforward and easy to navigate, so I could just focus on studying without wasting time figuring things out. Honestly one of the better resources I found for Microsoft cert prep. Would definitely recommend it if you're studying for any Microsoft exam.",date:"2026-05-18",url:"https://www.trustpilot.com/reviews/6a0acd17a7b3ce4de09c3a97"},{id:"tp-6",platform:"trustpilot",name:"Matthias",isUsername:!1,rating:5,quote:"An extremely cool platform for preparing for certifications! Thanks to the excellent content, I passed the exam without any problems. The support was also quick and helpful. Highly recommended!",date:"2026-02-12",url:"https://www.trustpilot.com/reviews/698d94398cf314849d6ffba2"}];var f=s(62555),x=s.n(f);function g(e){let{rating:t}=e,s=Math.max(0,Math.min(5,t));return(0,a.jsxs)("span",{className:x().stars,"aria-label":"".concat(t," out of 5 stars"),children:[(0,a.jsx)("span",{className:x().starsBase,"aria-hidden":"true"}),(0,a.jsx)("span",{className:x().starsFill,"aria-hidden":"true",style:{clipPath:"inset(0 ".concat(100-s/5*100,"% 0 0)")}})]})}function v(e){let{item:t}=e,s=h[t.platform],r=function(e){let t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:120,s=(e||"").trim();if(!s)return"";let a=s.split(RegExp("(?<=[.!?\\u2026])\\s+")).map(e=>e.trim()).filter(Boolean),r=a.find(e=>e.length<=t&&e.split(/\s+/).length>1);if(r)return r;let i=a[0]||s;if(i.length<=t)return i;let n=i.slice(0,t),l=n.lastIndexOf(" ");return"".concat(n.slice(0,l>0?l:t).trimEnd(),"…")}(t.quote),i=function(e){let t=arguments.length>1&&void 0!==arguments[1]&&arguments[1],s=(e||"").trim();if(!s)return"Anonymous";if(t)return s;let a=s.split(/\s+/);if(1===a.length)return a[0];let r=a[0].charAt(0).toUpperCase(),i=a[a.length-1];return"".concat(r,". ").concat(i)}(t.name,t.isUsername),n=function(e){if(!e)return"";let t=new Date(e);return Number.isNaN(t.getTime())?"":t.toLocaleDateString("en-US",{month:"short",year:"numeric"})}(t.date);return(0,a.jsx)("div"